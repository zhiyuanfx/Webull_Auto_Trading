# Copy to .env. Never commit .env or paste these values into strategy files.
WEBULL_REGION=us

# Production OpenAPI credentials from Webull OpenAPI Management.
# Paste the exact App Key and App Secret with no quotes or spaces after `=`.
WEBULL_PROD_APP_KEY=
WEBULL_PROD_APP_SECRET=

# Optional UAT credentials. Leave blank to use LOCAL_SIM only.
WEBULL_UAT_APP_KEY=
WEBULL_UAT_APP_SECRET=

# Both this flag and an explicit UI confirmation are required for live mode.
WEBULL_LIVE_ENABLED=false
WEBULL_TOKEN_DIR=.runtime/webull_tokens
WEBULL_UAT_TOKEN_WAIT_SECONDS=15
WEBULL_PROD_TOKEN_WAIT_SECONDS=300

STRATEGY_DESK_DB_PATH=data/strategy_desk.db
STRATEGY_DESK_HOST=127.0.0.1
STRATEGY_DESK_PORT=8000
STRATEGY_DESK_LOG_LEVEL=INFO
RECORDING_ROOT=recordings
