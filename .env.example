# Copy to .env. Never commit .env or paste these values into prompts, logs, or code.
WEBULL_REGION=us

# Production OpenAPI credentials from Webull OpenAPI Management.
WEBULL_PROD_APP_KEY=
WEBULL_PROD_APP_SECRET=

# SDK token cache. This directory is ignored and may contain reusable 2FA tokens.
WEBULL_TOKEN_DIR=.runtime/webull_tokens
WEBULL_PROD_TOKEN_WAIT_SECONDS=300

# Optional legacy/default account identifier for read-only live account snapshots.
WEBULL_ACCOUNT_ID=

# Named account aliases for live strategy config. Alias names are shown in UI/diagnostics;
# account IDs remain local in .env.
WEBULL_ACCOUNT_DEFAULT_ALIAS=stock_margin
WEBULL_ACCOUNT_STOCK_CASH_ID=
WEBULL_ACCOUNT_STOCK_MARGIN_ID=
WEBULL_ACCOUNT_FUTURES_ID=

# Master kill switch for any future live order transmission path.
LIVE_EXECUTION_MASTER_ENABLE=false

# Local runtime. SQLite data stays under ignored .runtime/.
RUNTIME_DB_PATH=.runtime/webull_auto_trading.sqlite3
STRATEGIES_TEST_CONFIG_PATH=config/strategies.test.yml
STRATEGIES_LIVE_CONFIG_PATH=config/strategies.live.yml
QUOTE_MAX_STALENESS_SECONDS=30
ALLOW_DELAYED_QUOTES=false

# InsightSentry quote streaming for `webull-auto-trading serve`.
# Direct paid InsightSentry WebSocket access can use INSIGHTSENTRY_API_KEY.
# A cached INSIGHTSENTRY_WEBSOCKET_KEY may be used while unexpired.
INSIGHTSENTRY_STREAM_ENABLED=true
INSIGHTSENTRY_API_KEY=
INSIGHTSENTRY_RAPIDAPI_KEY=
INSIGHTSENTRY_RAPIDAPI_HOST=insightsentry.p.rapidapi.com
INSIGHTSENTRY_WEBSOCKET_KEY=
INSIGHTSENTRY_WEBSOCKET_KEY_EXPIRATION=
