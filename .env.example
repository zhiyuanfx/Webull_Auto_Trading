# Copy to .env. Never commit .env or paste these values into Pine scripts.
WEBULL_REGION=us

# Production OpenAPI credentials from Webull OpenAPI Management.
WEBULL_PROD_APP_KEY=
WEBULL_PROD_APP_SECRET=

# SDK token cache. This directory is ignored and may contain reusable 2FA tokens.
WEBULL_TOKEN_DIR=.runtime/webull_tokens
WEBULL_PROD_TOKEN_WAIT_SECONDS=300

# Local bridge server. TradingView must reach this through your own HTTPS tunnel/forwarder.
WEBULL_BRIDGE_DB_PATH=data/webull_bridge.db
WEBULL_BRIDGE_HOST=127.0.0.1
WEBULL_BRIDGE_PORT=8000
WEBULL_BRIDGE_LOG_LEVEL=INFO

# Global live-execution safety switch. False accepts and queues valid webhooks but does not trade.
BRIDGE_EXECUTION_ENABLED=false

# Optional first route created by `webull-bridge init-db`.
BRIDGE_DEFAULT_ROUTE_ID=tv
BRIDGE_DEFAULT_ROUTE_NAME=TradingView
BRIDGE_DEFAULT_SECRET=
WEBULL_ACCOUNT_ID=
